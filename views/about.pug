extends layout.pug

block content
	nav.nav.center
		a(href="/")
			span.arrow ←
			|  Back to Gallery

	article.portfolio-about
		.inner-wrapper.flex-row-wrap.two-col
			.about-intro-box.box
				h1 James "Breck" Cooper
				h2 Senior Front-End Developer
				
				.about-bio
					img.profile-pic(src="/static/images/profile.png", alt="Profile Picture")
					p Hi! I'm an experienced Software Engineer with 8+ years in the industry, currently working as a Senior Front-End Developer at KnowBe4, where I build training modules and localized content with a strong focus on accessibility and responsive design.
					p My background spans audio engineering at Belmont University, graphic design at Immortal Printing, and a Master's in Computer Science from MTSU — a path that shaped my eye for design and grounded it in technical depth.
					p That combination drives everything I build: interactive, accessible web experiences that put the user first.

		.skills-contact-box.box
			h6 Education
			.education-skills-grid
				.section-category
					h6 Master of Science in Computer Science
					.education-item
						.degree-title Middle Tennessee State University
						.school-name Murfreesboro, TN
						.education-dates Aug 2013 - Dec 2016
				
				.section-category
					h6 Bachelor of Science in Audio Engineering
					.education-item
						.degree-title Belmont University
						.school-name Nashville, TN
						.education-dates Aug 2007 - Dec 2010
			
			h6 Technical Skills
			.education-skills-grid
				.section-category
					h6 Languages
					ul.skills-list
						li JavaScript
						li Python
						li C#
						li HTML/CSS

				.section-category
					h6 Front-End Development
					ul.skills-list
						li React (Experienced)
						li Vue (Experienced)
						li Express.js
						li User Interface Design
						li Responsive Design
				
				.section-category
					h6 Design & UX
					ul.skills-list
						li Wireframing (Expert)
						li Prototyping (Expert)
						li Accessibility (Experienced)
						li Adobe Creative Suite
						li User-Centric Design
				
				.section-category
					h6 Development Tools
					ul.skills-list
						li GitLab (Experienced)
						li Unix (Expert)
						li Unity
						li Jira
						li API Integration

				.section-category
					h6 AI-Assisted Development
					ul.skills-list
						li Claude Code (Claude.ai)
						li Prompt Engineering
						li AI Pair Programming
						li Module & PDF Automation
						li Iterative Build Workflows
			
			h6 Contact Info
			ul.contact-info
				li 
					span.label Location: 
					| Nashville, TN
				li
					span.label LinkedIn:
					a(href="https://www.linkedin.com/in/breck-cooper-aa006245/" target="_blank") breck-cooper
				li 
					span.label Email: 
					a(href="mailto:breckcooper@gmail.com") breckcooper@gmail.com
				li 
					span.label GitHub: 
					a(href="https://github.com/Stagol33" target="_blank") @Stagol33
			
			a.btn-link(href="https://github.com/Stagol33" target="_blank") View GitHub Profile

		.certification-box.box
			h6 Certifications
			img(src="https://api.accredible.com/v1/frontend/credential_website_embed_image/certificate/156941825", alt="Techdegree Full Stack Javascript Certificate", style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 8px;")
			img(src="https://api.accredible.com/v1/frontend/credential_website_embed_image/certificate/187685043", alt="Techdegree Data Analysis Certificate", style="max-width: 100%; height: auto; border: 1px solid #ddd; border-radius: 8px;")
